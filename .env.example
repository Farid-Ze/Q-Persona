# Supabase Configuration (Recommended BaaS)
# Get these from your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api

# Public keys (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key (server-side only, keep secret!)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Site URL (for redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe Configuration
# Get these from your Stripe dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Price IDs (from your Stripe dashboard)
STRIPE_PRICE_FREE=
STRIPE_PRICE_PRO=price_your_pro_price_id_here
STRIPE_PRICE_BUSINESS=price_your_business_price_id_here

# PostHog Analytics
# Get these from your PostHog project: https://posthog.com/settings/project
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Alternative: Direct PostgreSQL connection (if not using Supabase)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=q_persona
# DB_USER=postgres
# DB_PASSWORD=your_password_here
# DB_SSL=false

# Database connection pool (for direct PostgreSQL)
# DB_POOL_MAX=20
# DB_IDLE_TIMEOUT=30000
# DB_CONNECTION_TIMEOUT=2000

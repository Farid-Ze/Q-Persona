# Supabase Configuration (Recommended BaaS)
# Get these from your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api

# Public keys (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key (server-side only, keep secret!)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Site URL (for redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Alternative: Direct PostgreSQL connection (if not using Supabase)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=q_persona
# DB_USER=postgres
# DB_PASSWORD=your_password_here
# DB_SSL=false

# Database connection pool (for direct PostgreSQL)
# DB_POOL_MAX=20
# DB_IDLE_TIMEOUT=30000
# DB_CONNECTION_TIMEOUT=2000
